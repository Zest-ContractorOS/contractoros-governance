    {
      "rule_id": "COS-H1-PRMC-001",
      "version_introduced": "1.2.0",
      "status": "ACTIVE",
      "normative_text": "When a next-actor prompt exists, it must appear complete before the Product development stage block of the final reporting order.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": ["H1B1-OUT-006"],
      "source_decision_ids": ["H1B1-GATE-005"],
      "supersedes": [],
      "superseded_by": []
    },
    {
      "rule_id": "COS-H1-PRMC-002",
      "version_introduced": "1.2.0",
      "status": "ACTIVE",
      "normative_text": "Complete prompts must be self-contained, independently pasteable, target-role and target-surface specific, scope bounded, and explicit about stop conditions and authority limits.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": ["H1B1-OUT-008"],
      "source_decision_ids": ["H1B1-GATE-005"],
      "supersedes": [],
      "superseded_by": []
    },
    {
      "rule_id": "COS-H1-PRMC-003",
      "version_introduced": "1.2.0",
      "status": "ACTIVE",
      "normative_text": "Downloadable prompt files are convenience artifacts with no authority. Each requires prompt ID, target role, target surface, authority reference, SHA-256, UTF-8 byte count, inline identity and stop summary, and an unavailable-file fallback.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": ["H1B1-OUT-013"],
      "source_decision_ids": ["H1B1-GATE-005"],
      "supersedes": [],
      "superseded_by": []
    },
    {
      "rule_id": "COS-H1-PRMC-004",
      "version_introduced": "1.2.0",
      "status": "ACTIVE",
      "normative_text": "DEFECT_4=CODEX_EXECUTION_PROMPT_OMITTED_MANDATORY_ORDERED_TEN_FIELD_PROFILE is recorded as a durable defect. Every substantive execution prompt must begin with the exact ordered ten-field model, effort, speed, agent, quota, context, checkpoint, and scope profile defined by the prompt convention; a prompt missing or reordering the profile is contract-invalid.",
