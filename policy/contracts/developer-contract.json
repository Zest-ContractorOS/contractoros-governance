    {
      "rule_id": "COS-H1-DEVC-001",
      "version_introduced": "1.2.0",
      "status": "ACTIVE",
      "normative_text": "Developer outputs follow one provider-neutral schema: linked phase issue, declared lane, exact scope with file allowlist, starting main SHA, changed files, commands run with results, validation evidence, forbidden-scope confirmation, claim level with explicit non-proven items, known limitations, and remaining gates. Provider-specific adapters may extend but must not redefine, remove, or reorder the core sections.",
