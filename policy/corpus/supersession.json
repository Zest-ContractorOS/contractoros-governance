  "rules": [
    {
      "rule_id": "COS-H1-SUPER-001",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Historical evidence must be preserved. Corrections to current policy must not silently replace, delete, or conceal earlier durable records.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-AUTH-010"
      ],
      "source_decision_ids": [],
      "supersedes": [],
      "superseded_by": [],
      "design_decision_ids": []
    },
    {
      "rule_id": "COS-H1-SUPER-002",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Every supersession must record explicit lineage. Superseded rules remain preserved and must identify replacements through superseded_by. Replacing rules must list prior rule IDs in supersedes.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-AUTH-010"
      ],
      "source_decision_ids": [
        "H1B1-OD-003"
      ],
      "supersedes": [],
      "superseded_by": [],
      "design_decision_ids": []
    },
    {
      "rule_id": "COS-H1-SUPER-003",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Rule-ID reuse with a different meaning is prohibited. A rule ID is permanently bound to its original meaning namespace even after SUPERSEDED, DEPRECATED, or RETIRED status.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [],
      "source_decision_ids": [
        "H1B1-OD-003"
      ],
      "supersedes": [],
      "superseded_by": [],
      "design_decision_ids": []
    },
    {
      "rule_id": "COS-H1-SUPER-004",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Allowed rule lifecycle statuses are exactly ACTIVE, DEPRECATED, SUPERSEDED, and RETIRED.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [],
      "source_decision_ids": [
        "H1B1-OD-003"
      ],
      "supersedes": [],
      "superseded_by": [],
      "allowed_statuses": [
        "ACTIVE",
        "DEPRECATED",
        "SUPERSEDED",
        "RETIRED"
      ],
      "design_decision_ids": []
    },
    {
      "rule_id": "COS-H1-SUPER-005",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Corpus and rule versioning use semantic versioning. Initial corpus_version is 1.0.0. Deprecation requires status=DEPRECATED, a deprecation reason, and either a successor reference or an explicit no-successor justification.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [],
      "source_decision_ids": [
        "H1B1-OD-003"
      ],
      "supersedes": [],
      "superseded_by": [],
      "versioning_model": "SEMANTIC_VERSIONING",
      "initial_corpus_version": "1.0.0",
      "design_decision_ids": []
    },
    {
      "rule_id": "COS-H1-SUPER-006",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Automatic Git-history rewriting to erase historical evidence is prohibited. Correcting current policy is distinct from erasing historical evidence.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-AUTH-010"
      ],
      "source_decision_ids": [],
