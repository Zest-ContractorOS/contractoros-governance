    {
      "rule_id": "COS-H1-GATE-001",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "The canonical gate sequence is exactly: H1_B0, H1_B1A_G, H1_B1A_P, H1_B1B_G, H1_B1B_P, H1_B1C, H1_B2, H1_B3, H1_B4, and H1_B5. Only these canonical gate identifiers may be used when an exact gate is intended; ambiguous aliases or ranges are blocked.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-GATE-001",
        "H1B1-GATE-011"
      ],
      "source_decision_ids": [],
