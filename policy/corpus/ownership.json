        "OWNER_AUTHORITY",
        "DEVELOPER_IMPLEMENTATION",
        "INDEPENDENT_EXACT_SHA_RED_TEAM_REVIEW",
        "SEPARATE_QUALIFYING_HUMAN_APPROVAL",
        "PROTECTED_MERGE",
        "VERIFIED_MAIN"
      ],
      "design_decision_ids": []
    },
    {
      "rule_id": "COS-H1-OWNER-003",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "ContractorOS presently has one human owner. The same account may perform owner, approval, and merge acts, but each act must be separately recorded and must not be collapsed into one event.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-AUTH-004"
      ],
      "source_decision_ids": [
