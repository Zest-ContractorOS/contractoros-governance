    {
      "rule_id": "COS-H1-OWNER-004",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "The Developer machine account danidon-wq may not act as owner, policy approver, human approver, independent Red Team approver, or merge approver.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [],
      "source_decision_ids": [
        "H1B1-OD-005"
