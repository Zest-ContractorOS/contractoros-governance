    {
      "rule_id": "COS-H1-GATE-003",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Normative rules must exist once in canonical machine-readable JSON. Non-normative Markdown may contain short summaries, navigation, diagrams, examples, implementation guidance, and references to canonical rule IDs and JSON paths. Duplicating full normative rule text as an independently maintainable policy source is prohibited. Generated summaries are permitted only after a later compiler gate exists.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-OPS-001"
      ],
      "source_decision_ids": [
        "H1B1-OD-002",
        "H1B1-OD-020"
      ],
      "supersedes": [],
      "superseded_by": [],
      "canonical_normative_data_format": "JSON",
      "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
      "duplicated_normative_prose": "PROHIBITED",
      "design_decision_ids": []
    },
    {
      "rule_id": "COS-H1-GATE-004",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Complete dependency and impact manifests are required for every governing rule, schema, compiler, validator, consumer, fixture, and generated document. For H1_B1A_G, the sole machine-readable inventory is policy/corpus/governing-files.json dependency_impact_entries. Every current governing file, policy document, schema, and rule ID must appear. Future component classes that do not yet exist must appear with existence_status=NOT_YET_EXISTS and an assigned canonical gate.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-OPS-002",
        "H1B1-GATE-003"
      ],
      "source_decision_ids": [],
      "supersedes": [],
      "superseded_by": [],
      "design_decision_ids": []
    },
    {
      "rule_id": "COS-H1-GATE-005",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Migration gates must use small bounded allowlists and must not combine governance and product blast radius in one change.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-OPS-004"
