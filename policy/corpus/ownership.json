    {
      "rule_id": "COS-H1-OWNER-010",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "The implementation machine account danidon-wq must not provide owner authority, human approval, Red-Team approval, self-approval of its own implementation, merge authority, scope widening, or automatic continuation.",
