      "status": "ACTIVE",
      "normative_text": "Posting-ready contract for the future child issue: ISSUE_CREATION_AUTHORITY_REFERENCE must be an exact future owner authority comment; ISSUE_CREATION_AUTHORITY_VERIFIED=YES after live verification; AUTHORITY_CREATED_BY_THIS_ISSUE=NO; FURTHER_GITHUB_POSTING_AUTHORIZED_BY_THIS_ISSUE=NO; IMPLEMENTATION_AUTHORITY=NONE meaning the child issue does not create implementation authority.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-POST-002",
        "H1B1-POST-003",
        "H1B1-DEC-003"
