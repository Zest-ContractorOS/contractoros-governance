    {
      "rule_id": "COS-H1-OWNER-002",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "The control lifecycle is separately recorded as: (1) owner authority; (2) Developer implementation; (3) independent exact-SHA Red Team review; (4) separate qualifying human approval; (5) protected merge; (6) verified main.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-AUTH-004"
      ],
      "source_decision_ids": [
        "H1B1-OD-005"
      ],
      "supersedes": [],
      "superseded_by": [],
