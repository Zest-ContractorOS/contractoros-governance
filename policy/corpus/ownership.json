    {
      "rule_id": "COS-H1-OWNER-005",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Issue hierarchy: Issue #58 is the H1 parent and owner-authority spine; Issue #78 is the master H1-B1 planning requirements and sequence ledger; a future dedicated child issue in Zest-LeadGen/contractoros-california is the H1-B1A-G bounded implementation record; the governance pull request in Zest-ContractorOS/contractoros-governance is the H1-B1A-G implementation vehicle. No H1-B1A-G implementation issue is created in the governance repository.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-POST-003",
        "H1B1-POST-004"
      ],
      "source_decision_ids": [
        "H1B1-OD-014"
      ],
      "supersedes": [],
      "superseded_by": [],
      "design_decision_ids": []
    },
    {
      "rule_id": "COS-H1-OWNER-006",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "A child implementation issue creates no authority for its own creation or later action. Issue-creation authority fields are derived verification fields referring to external durable owner authority. IMPLEMENTATION_AUTHORITY remains LIVE_GITHUB_REQUIRED until a live owner implementation-authorization comment is posted and independently verified.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-POST-002",
        "H1B1-POST-003",
