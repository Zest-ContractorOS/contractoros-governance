    {
      "rule_id": "COS-H1-OWNER-007",
      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Post-creation Issue #58 linkage templates cannot be finalized until GitHub assigns the actual child issue number and direct URL. Only <ACTUAL_CHILD_ISSUE_NUMBER> and <ACTUAL_CHILD_ISSUE_URL> substitutions are permitted in that linkage template.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
        "H1B1-POST-004",
        "H1B1-POST-005"
      ],
