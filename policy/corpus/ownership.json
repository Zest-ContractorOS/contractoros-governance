      "version_introduced": "1.0.0",
      "status": "ACTIVE",
      "normative_text": "Unresolved owner decisions may exist when a planning issue is created. Unresolved decisions create no implementation authority. Every unresolved owner decision must be assigned to a canonical dependent gate and that gate is blocked until the decision is resolved or explicitly deferred under an approved rule.",
      "classification": "STABLE_POLICY",
      "owner": "Zest-LeadGen",
      "source_requirement_ids": [
