{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contractoros-governance/schemas/authorization/phase-authorization-2.0.schema.json",
  "$comment": "Generation 2.0.0 of the phase-authorization contract (H3R, product issue #156, owner decisions issue-156-comment-5248859501, authorization issue-156-comment-5248861054). EXPLICIT_LINEAGE: supersedes phase-authorization.schema.json (1.x) FOR NEW GRANTS ONLY per COS-H1-SUPER-008; 1.x remains immutable and valid for historical records. Trust model (owner decisions D1/D3/D8): the owner GitHub comment payload (AUTHORIZATION_CORE) is the authoritative grant; a record conforming to this schema is a machine-verified PROJECTION of that grant. The AUTHORIZATION_CORE is this record minus evidence_comment_id and payload_sha256. CANONICALIZATION (D3): payload_sha256 = sha256 over the RFC 8785 (JCS) canonicalization of the AUTHORIZATION_CORE as posted in the owner comment; grants are restricted to strings/integers/arrays/objects \u2014 floats and exponent forms are prohibited. LIFECYCLE: grants are immutable after sealing; revocation/expiry/supersession/consumption live in separate append-only status records, never in this record.",
  "title": "ContractorOS phase authorization (generation 2.0.0, owner-sealed projection)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "authorization_id",
    "repository",
    "issue",
    "base_branch",
    "base_sha",
    "lane",
    "expiry",
    "developer_principal",
    "approver_principals",
    "allowed_paths",
    "forbidden_paths",
    "required_checks",
    "review_classes",
    "owner_trigger_categories",
    "classifications",
    "supersedes",
    "pr_binding",
    "evidence_comment_id",
    "payload_sha256",
    "canonicalization"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^PA-[0-9]{4}$"
    },
    "repository": {
      "type": "string",
      "minLength": 3
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "base_branch": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "EXACT base equality required at validation time (owner decision D2); ancestor lineage is not sufficient."
    },
    "lane": {
      "enum": [
        "Control / Infrastructure",
        "Product / QA",
        "Dependency"
      ]
    },
    "lane_note": {
      "type": "string",
      "description": "Optional free-text lane qualifier; carries no authority semantics."
    },
    "expiry": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "developer_principal": {
      "type": "string",
      "minLength": 1,
      "description": "Must resolve to a principal-matrix entry; the live PR author numeric ID must equal that principal's account_id (owner decision D4)."
    },
    "approver_principals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "pattern",
          "change_kinds"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^ALLOW-[0-9]{3}$"
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "change_kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "add",
                "modify",
                "delete",
                "relocate"
              ]
            }
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "owner_directed_disclosed_nonindependent",
          "independent_fresh_context",
          "owner_human_approval",
          "opus5_read_only_exact_head_independent_leg"
        ]
      }
    },
    "owner_trigger_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "classifications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency",
        "build",
        "release",
        "data",
        "security"
      ],
      "properties": {
        "dependency": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "string",
          "minLength": 1
        },
        "security": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PA-[0-9]{4}$"
      },
      "description": "Grant lineage only; lifecycle state lives in append-only status records, never here."
    },
    "pr_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_repository",
        "head_ref",
        "base_repository",
        "base_ref",
        "authorization_id",
        "nonce"
      ],
      "description": "Mandatory PR-instance binding (owner decision D7): verified against stable API fields of the live PR object, never PR prose; the head_ref is unique per authorization and never reused; the nonce appears in exactly one grant.",
      "properties": {
        "head_repository": {
          "type": "string",
          "minLength": 3
        },
        "head_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_repository": {
          "type": "string",
          "minLength": 3
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "authorization_id": {
          "type": "string",
          "pattern": "^PA-[0-9]{4}$"
        },
        "nonce": {
          "type": "string",
          "minLength": 16
        }
      }
    },
    "evidence_comment_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Post-hoc evidence field (excluded from the AUTHORIZATION_CORE): the owner authorization comment ID carrying the sealed core."
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Post-hoc evidence field (excluded from the AUTHORIZATION_CORE): sha256 of the RFC 8785 canonicalization of the core as posted by the owner."
    },
    "canonicalization": {
      "const": "RFC_8785_JCS"
    }
  }
}
